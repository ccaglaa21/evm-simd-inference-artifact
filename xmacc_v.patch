+    // Gas constants of the view instruction XMACC_V: a charge per call, a charge per group of eight
+    // elements, and a charge per element that is read through a stride other than one, on every call.
+    // The values come from the measured times of four builds with the strided elements in the hostile
+    // layout (training/price_calibration.py).
+#define XMACC_V_CALL_GAS 50
+#define XMACC_V_GROUP_GAS 10
+#define XMACC_V_STRIDED_GAS 4
+
+    // Row kernel of XMACC_V: accumulates the element-wise products of two rows into the eight
+    // int32 lanes held in ab. da and db point at the first element of each row, sa and sb are the
+    // byte distances between consecutive elements (2 for a unit-stride row), n is the element count.
+    // The caller has bounds-checked both rows.
+    static inline void view_rows_macc(uint8_t* ab, const uint8_t* da, size_t sa, const uint8_t* db,
+        size_t sb, uint64_t n) noexcept
+    {
+        // A group of eight elements is read either in place (unit stride, full group) or element by
+        // element into two 64-bit integers (strided row or partial last group; element j at bits
+        // 16 (j mod 4) of the low or the high integer, the unused lanes are zero and add nothing).
+        // The integers go to the vector register directly, without passing through memory. The lane
+        // arithmetic then is the same for both cases.
+        const auto collect = [](const uint8_t* d, size_t step, uint64_t cnt, uint64_t& lo, uint64_t& hi) noexcept {
+            lo = 0;
+            hi = 0;
+            for (uint64_t j = 0; j < cnt; ++j)
+            {
+                uint16_t e;
+                std::memcpy(&e, d + j * step, 2);
+                if (j < 4)
+                    lo |= static_cast<uint64_t>(e) << (16 * j);
+                else
+                    hi |= static_cast<uint64_t>(e) << (16 * (j - 4));
+            }
+        };
+#if defined(__AVX2__)
+        __m256i acc = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(ab));
+#elif defined(__ARM_NEON) && !defined(EVMONE_NO_NEON)
+        int32x4_t acc_lo = vreinterpretq_s32_u8(vld1q_u8(ab));
+        int32x4_t acc_hi = vreinterpretq_s32_u8(vld1q_u8(ab + 16));
+#else
+        int32_t acc[8];
+        std::memcpy(acc, ab, 32);
+#endif
+        for (uint64_t t0 = 0; t0 < n; t0 += 8)
+        {
+            const uint64_t cnt = (n - t0 < 8) ? (n - t0) : 8;
+            const bool in_place_a = (sa == 2 && cnt == 8);
+            const bool in_place_b = (sb == 2 && cnt == 8);
+            uint64_t alo = 0, ahi = 0, blo = 0, bhi = 0;
+            if (!in_place_a)
+                collect(da + t0 * sa, sa, cnt, alo, ahi);
+            if (!in_place_b)
+                collect(db + t0 * sb, sb, cnt, blo, bhi);
+#if defined(__AVX2__)
+            const __m128i a16 = in_place_a ? _mm_loadu_si128(reinterpret_cast<const __m128i*>(da + 2 * t0)) :
+                                             _mm_set_epi64x(static_cast<long long>(ahi), static_cast<long long>(alo));
+            const __m128i b16 = in_place_b ? _mm_loadu_si128(reinterpret_cast<const __m128i*>(db + 2 * t0)) :
+                                             _mm_set_epi64x(static_cast<long long>(bhi), static_cast<long long>(blo));
+            acc = sat_add32_v(acc, _mm256_mullo_epi32(_mm256_cvtepi16_epi32(a16), _mm256_cvtepi16_epi32(b16)));
+#elif defined(__ARM_NEON) && !defined(EVMONE_NO_NEON)
+            const int16x8_t a16 = in_place_a ? vreinterpretq_s16_u8(vld1q_u8(da + 2 * t0)) :
+                                               vreinterpretq_s16_u64(vcombine_u64(vcreate_u64(alo), vcreate_u64(ahi)));
+            const int16x8_t b16 = in_place_b ? vreinterpretq_s16_u8(vld1q_u8(db + 2 * t0)) :
+                                               vreinterpretq_s16_u64(vcombine_u64(vcreate_u64(blo), vcreate_u64(bhi)));
+            acc_lo = vqaddq_s32(acc_lo, vmull_s16(vget_low_s16(a16), vget_low_s16(b16)));
+            acc_hi = vqaddq_s32(acc_hi, vmull_s16(vget_high_s16(a16), vget_high_s16(b16)));
+#else
+            if (in_place_a)
+            {
+                std::memcpy(&alo, da + 2 * t0, 8);
+                std::memcpy(&ahi, da + 2 * t0 + 8, 8);
+            }
+            if (in_place_b)
+            {
+                std::memcpy(&blo, db + 2 * t0, 8);
+                std::memcpy(&bhi, db + 2 * t0 + 8, 8);
+            }
+            for (int j = 0; j < 8; ++j)
+            {
+                const int16_t a = static_cast<int16_t>(static_cast<uint16_t>((j < 4 ? alo : ahi) >> (16 * (j & 3))));
+                const int16_t b = static_cast<int16_t>(static_cast<uint16_t>((j < 4 ? blo : bhi) >> (16 * (j & 3))));
+                acc[j] = sat_add32(acc[j], static_cast<int32_t>(a) * static_cast<int32_t>(b));
+            }
+#endif
+        }
+#if defined(__AVX2__)
+        _mm256_storeu_si256(reinterpret_cast<__m256i*>(ab), acc);
+#elif defined(__ARM_NEON) && !defined(EVMONE_NO_NEON)
+        vst1q_u8(ab, vreinterpretq_u8_s32(acc_lo));
+        vst1q_u8(ab + 16, vreinterpretq_u8_s32(acc_hi));
+#else
+        std::memcpy(ab, acc, 32);
+#endif
+    }
+
+    // --- XMACC_V: row-level multiply-accumulate over two matrix views ---
+    // Stack (pop order): off_a, row_a, off_b, row_b. The accumulator word (8 x int32 lanes) stays on
+    // the stack and is updated in place, as for XMACC_N.
+    // Both operands are matrices with a 32-byte MatrixHeader followed by int16 elements. Row r of a
+    // view is the element sequence data[r*stride_row + t*stride_col], t = 0..cols-1, so a transposed
+    // view (XTRANSPOSE swaps the shape and the strides) yields a column of the stored matrix without
+    // a copy. The instruction multiplies row_a of view A with row_b of view B element by element:
+    //     acc[t mod 8] = sat(acc[t mod 8] + a[t] * b[t])      (t = 0..cols-1)
+    // with the lane arithmetic of the other accumulation instructions (16->32 widening, saturating
+    // 32-bit addition). Without saturation the lane sum (XSUM32) is the dot product of the two rows.
+    // The element count is not an operand. It is the column count of the views, and the two views
+    // must agree on it, otherwise the instruction halts (a shape error).
+    // Gas: XMACC_V_CALL_GAS per call, XMACC_V_GROUP_GAS per group of eight elements (the last group
+    // may be partial) and XMACC_V_STRIDED_GAS per element of each row whose column stride is not
+    // one. The charge is made before any element access; memory expansion is charged by check_memory.
+    // SECURITY: the row indices are checked against the row counts, the column count must fit in 31
+    // bits, and the highest element of each row is bounds-checked in uint256 before any read.
+    // The instruction writes no memory.
+    static inline Result xmacc_v(StackTop stack, int64_t gas_left, ExecutionState& state) noexcept
+    {
+        const auto off_a = stack.pop();
+        const auto row_a = stack.pop();
+        const auto off_b = stack.pop();
+        const auto row_b = stack.pop();
+        auto& vacc = stack[0];
+        if (!check_memory(gas_left, state.memory, off_a, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (!check_memory(gas_left, state.memory, off_b, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        evmone::numpy::MatrixHeader ha, hb;
+        std::memcpy(&ha, &state.memory[static_cast<size_t>(off_a)], sizeof(ha));
+        std::memcpy(&hb, &state.memory[static_cast<size_t>(off_b)], sizeof(hb));
+        if (ha.cols != hb.cols || ha.cols > 0x7fffffffULL)
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (!(row_a < uint256(ha.rows)) || !(row_b < uint256(hb.rows)))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        const uint64_t n = ha.cols;
+        const int64_t strided_rows = (ha.stride_col != 1 ? 1 : 0) + (hb.stride_col != 1 ? 1 : 0);
+        const int64_t charge = XMACC_V_CALL_GAS + static_cast<int64_t>((n + 7) / 8) * XMACC_V_GROUP_GAS +
+                               static_cast<int64_t>(n) * strided_rows * XMACC_V_STRIDED_GAS;       // n < 2^31
+        if ((gas_left -= charge) < 0)
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (n == 0)
+            return {EVMC_SUCCESS, gas_left};
+        // Highest element of each row and its byte bound. When the row indices and the strides are
+        // below 2^30 the bound fits in 64 bits (the count is below 2^31) and is computed there.
+        // Otherwise it is computed in uint256, where it cannot overflow. Both give the same value.
+        constexpr uint64_t SMALL = uint64_t{1} << 30;
+        uint256 top_a, top_b;
+        uint64_t base_a = 0, base_b = 0;
+        const bool small = ((row_a[3] | row_a[2] | row_a[1] | row_b[3] | row_b[2] | row_b[1]) == 0) &&
+            row_a[0] < SMALL && row_b[0] < SMALL && ha.stride_row < SMALL && ha.stride_col < SMALL &&
+            hb.stride_row < SMALL && hb.stride_col < SMALL;
+        if (small)
+        {
+            base_a = row_a[0] * ha.stride_row;
+            base_b = row_b[0] * hb.stride_row;
+            top_a = off_a + uint256(32 + 2 * (base_a + (n - 1) * ha.stride_col));
+            top_b = off_b + uint256(32 + 2 * (base_b + (n - 1) * hb.stride_col));
+        }
+        else
+        {
+            const uint256 wa = row_a * uint256(ha.stride_row);
+            const uint256 wb = row_b * uint256(hb.stride_row);
+            top_a = off_a + uint256(32) + (wa + uint256(n - 1) * uint256(ha.stride_col)) * uint256(2);
+            top_b = off_b + uint256(32) + (wb + uint256(n - 1) * uint256(hb.stride_col)) * uint256(2);
+            // If the two checks below pass, the element offsets are below the memory size, so the
+            // low 64 bits of the row bases are the row bases.
+            base_a = wa[0];
+            base_b = wb[0];
+        }
+        if (!check_memory(gas_left, state.memory, top_a, 2))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (!check_memory(gas_left, state.memory, top_b, 2))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        const uint8_t* da = &state.memory[static_cast<size_t>(off_a)] + 32 + 2 * static_cast<size_t>(base_a);
+        const uint8_t* db = &state.memory[static_cast<size_t>(off_b)] + 32 + 2 * static_cast<size_t>(base_b);
+        const size_t sa = 2 * static_cast<size_t>(ha.stride_col);
+        const size_t sb = 2 * static_cast<size_t>(hb.stride_col);
+        uint8_t ab[32];
+        std::memcpy(ab, &vacc, 32);
+        view_rows_macc(ab, da, sa, db, sb, n);
+        std::memcpy(&vacc, ab, 32);
+        return {EVMC_SUCCESS, gas_left};
+    }
+
     // --- XMACC_S: STRIDE-AWARE MACC (uses the zero-copy transpose without copying) ---
     // Stack: [Mat_Offset, Inp_Offset, Acc_Offset]. config byte (pos[1]) = row index r.
     // Reads row r of the transposed matrix (an original column, strided) WITHOUT COPYING.
