+    // --- XMATMUL: matrix-level multiply-accumulate over two matrix views ---
+    // Stack (pop order): off_a, off_b, dst. Nothing is pushed.
+    // A and B are matrix views (32-byte MatrixHeader, int16 elements) with the same column count n.
+    // For every row i of A and every row j of B the instruction writes one 256-bit word to memory:
+    //     word(dst + 32 * (i * rows_B + j)) = XSUM32( XMACC_V applied to a zero accumulator, row i of A, row j of B )
+    // that is, the saturating sum of the eight lanes of the row product, as an unsigned 32-bit pattern.
+    // The result equals a loop of XMACC_V, XSUM32 and MSTORE over all pairs of rows, with one dispatch.
+    // With transposed views (XTRANSPOSE) the rows are stored columns, so XMATMUL(A^T, A^T) is the Gram
+    // matrix of A and XMATMUL(A, B^T) is the product A * B, without a copy.
+    // A view whose column stride is not one is packed: its elements are read once into a contiguous
+    // buffer (all rows of B, and each row of A when it is used), as dense linear-algebra kernels do, and
+    // the products are formed on contiguous data. When A and B are the same view (off_a == off_b, the
+    // Gram case), the view is packed once and its packed rows serve as the rows of both operands.
+    // The packed elements are copies of elements that are in the memory of the contract. The packed
+    // form of a strided B (rows_B * cols * 2 bytes) must not be larger than that memory, otherwise the
+    // instruction halts: a view whose rows share elements (a zero stride) can describe more elements
+    // than the memory holds. One packed row of A (cols * 2 bytes) is never larger than the memory,
+    // because B holds at least as many bytes: a unit-stride row of B occupies cols * 2 bytes of the
+    // memory, and a strided B has passed the rule above.
+    // Gas: XMATMUL_CALL_GAS per call, XMATMUL_ENTRY_GAS per output entry, XVIEW_UNIT_GROUP_GAS per entry
+    // and group of eight elements, and XVIEW_STRIDED_ELEMENT_GAS per packed element (rows_B * cols for a
+    // strided B, and rows_A * cols for a strided A that is not the same view as B). The charge is made
+    // in 128-bit arithmetic before any element access; memory expansion of the output is charged by
+    // check_memory.
+    // SECURITY: equal column counts are required (shape error otherwise); rows and columns must fit in
+    // 31 bits; the highest element of each view and the whole output range are bounds-checked in
+    // uint256 before any access; the output range must not overlap the element range of A or B.
+    static inline Result xmatmul(StackTop stack, int64_t gas_left, ExecutionState& state) noexcept
+    {
+        const auto off_a = stack.pop();
+        const auto off_b = stack.pop();
+        const auto dst = stack.pop();
+        if (!check_memory(gas_left, state.memory, off_a, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (!check_memory(gas_left, state.memory, off_b, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        evmone::numpy::MatrixHeader ha, hb;
+        std::memcpy(&ha, &state.memory[static_cast<size_t>(off_a)], sizeof(ha));
+        std::memcpy(&hb, &state.memory[static_cast<size_t>(off_b)], sizeof(hb));
+        constexpr uint64_t LIM = 0x7fffffffULL;
+        if (ha.cols != hb.cols || ha.cols > LIM || ha.rows > LIM || hb.rows > LIM)
+            return {EVMC_OUT_OF_GAS, gas_left};
+        const uint64_t n = ha.cols, ra = ha.rows, rb = hb.rows;
+        const bool strided_a = ha.stride_col != 1, strided_b = hb.stride_col != 1;
+        const bool same_view = off_a == off_b;                                           // one header, so one view
+        const unsigned __int128 entries = static_cast<unsigned __int128>(ra) * rb;       // below 2^62
+        const unsigned __int128 packed = (strided_a && !same_view ? static_cast<unsigned __int128>(ra) * n : 0) +
+                                         (strided_b ? static_cast<unsigned __int128>(rb) * n : 0);       // below 2^63
+        const unsigned __int128 charge = XMATMUL_CALL_GAS +
+            entries * (XMATMUL_ENTRY_GAS + static_cast<unsigned __int128>((n + 7) / 8) * XVIEW_UNIT_GROUP_GAS) +
+            packed * XVIEW_STRIDED_ELEMENT_GAS;
+        if (charge > static_cast<unsigned __int128>(gas_left))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        gas_left -= static_cast<int64_t>(charge);
+        if (entries == 0)
+            return {EVMC_SUCCESS, gas_left};
+        const uint256 out_bytes = uint256(static_cast<uint64_t>(entries)) * uint256(32);
+        if (!check_memory(gas_left, state.memory, dst, out_bytes))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        // Element ranges of the two views: [first, last + 2) in bytes. An empty row (n == 0) reads nothing.
+        uint256 end_a = off_a + uint256(32), end_b = off_b + uint256(32);
+        if (n != 0)
+        {
+            end_a += (uint256(ra - 1) * uint256(ha.stride_row) + uint256(n - 1) * uint256(ha.stride_col)) * uint256(2) + uint256(2);
+            end_b += (uint256(rb - 1) * uint256(hb.stride_row) + uint256(n - 1) * uint256(hb.stride_col)) * uint256(2) + uint256(2);
+            if (!check_memory(gas_left, state.memory, end_a - uint256(2), 2))
+                return {EVMC_OUT_OF_GAS, gas_left};
+            if (!check_memory(gas_left, state.memory, end_b - uint256(2), 2))
+                return {EVMC_OUT_OF_GAS, gas_left};
+        }
+        // The output must not overlap the header or the elements of either view.
+        const uint256 dst_end = dst + out_bytes;
+        if ((dst < end_a && off_a < dst_end) || (dst < end_b && off_b < dst_end))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        // All offsets are below the memory size from here on, so they fit in size_t.
+        const uint8_t* ea = &state.memory[static_cast<size_t>(off_a)] + 32;
+        const uint8_t* eb = &state.memory[static_cast<size_t>(off_b)] + 32;
+        uint8_t* out = &state.memory[static_cast<size_t>(dst)];
+        const size_t ra_step = 2 * static_cast<size_t>(ha.stride_row), rb_step = 2 * static_cast<size_t>(hb.stride_row);
+        const size_t sa = 2 * static_cast<size_t>(ha.stride_col), sb = 2 * static_cast<size_t>(hb.stride_col);
+        // The packed form of a strided view must fit in the memory of the contract (see above).
+        const size_t mem_size = state.memory.size();
+        const size_t bytes_b = static_cast<size_t>(rb) * static_cast<size_t>(n) * 2;     // below 2^63
+        const size_t bytes_a = static_cast<size_t>(n) * 2;
+        if (n != 0 && strided_b && bytes_b > mem_size)
+            return {EVMC_OUT_OF_GAS, gas_left};
+        // Packing changes neither the result nor the gas. If a buffer cannot be allocated on the host,
+        // the rows of that view are read in place, with the same result.
+        uint8_t* pack_b = nullptr;
+        uint8_t* pack_a = nullptr;
+        if (n != 0 && strided_b)
+        {
+            pack_b = static_cast<uint8_t*>(std::malloc(bytes_b));
+            if (pack_b != nullptr)
+                for (uint64_t j = 0; j < rb; ++j)
+                {
+                    const uint8_t* src = eb + j * rb_step;
+                    uint8_t* d = pack_b + j * n * 2;
+                    for (uint64_t t = 0; t < n; ++t)
+                        std::memcpy(d + 2 * t, src + t * sb, 2);
+                }
+        }
+        // The same view as both operands: the packed rows of B are the rows of A as well.
+        const bool shared = same_view && pack_b != nullptr;
+        if (n != 0 && strided_a && !shared)
+            pack_a = static_cast<uint8_t*>(std::malloc(bytes_a));
+        const size_t sb_eff = pack_b != nullptr ? 2 : sb;
+        const size_t sa_eff = (pack_a != nullptr || shared) ? 2 : sa;
+        for (uint64_t i = 0; i < ra; ++i)
+        {
+            const uint8_t* da = (n != 0) ? ea + i * ra_step : ea;
+            if (shared)
+                da = pack_b + i * n * 2;
+            else if (pack_a != nullptr)
+            {
+                for (uint64_t t = 0; t < n; ++t)
+                    std::memcpy(pack_a + 2 * t, da + t * sa, 2);
+                da = pack_a;
+            }
+            for (uint64_t j = 0; j < rb; ++j)
+            {
+                uint8_t ab[32] = {};
+                if (n != 0)
+                    view_rows_macc(ab, da, sa_eff, pack_b != nullptr ? pack_b + j * n * 2 : eb + j * rb_step, sb_eff, n);
+                int32_t lanes[8];
+                std::memcpy(lanes, ab, 32);
+                int64_t sum = 0;
+                for (int k = 0; k < 8; ++k)
+                    sum += lanes[k];
+                if (sum > static_cast<int64_t>(INT32_MAX)) sum = INT32_MAX;
+                if (sum < static_cast<int64_t>(INT32_MIN)) sum = INT32_MIN;
+                const uint32_t u = static_cast<uint32_t>(static_cast<int32_t>(sum));
+                std::memset(out, 0, 28);
+                out[28] = static_cast<uint8_t>(u >> 24);
+                out[29] = static_cast<uint8_t>(u >> 16);
+                out[30] = static_cast<uint8_t>(u >> 8);
+                out[31] = static_cast<uint8_t>(u);
+                out += 32;
+            }
+        }
+        std::free(pack_a);
+        std::free(pack_b);
+        return {EVMC_SUCCESS, gas_left};
+    }
+
+
     // --- XMACC_S: STRIDE-AWARE MACC (uses the zero-copy transpose without copying) ---
     // Stack: [Mat_Offset, Inp_Offset, Acc_Offset]. config byte (pos[1]) = row index r.
     // Reads row r of the transposed matrix (an original column, strided) WITHOUT COPYING.
