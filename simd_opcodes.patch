@@ -27,6 +27,9 @@ void analyze_jumpdests(BitsetSpan map, bytes_view code) noexcept
         const auto op = code[i];
         if (static_cast<int8_t>(op) >= OP_PUSH1)  // If any PUSH opcode (see explanation above).
             i += op - size_t{OP_PUSH1 - 1};       // Skip PUSH data.
+        else if (op == OP_XADD_IMM || op == OP_XMUL_IMM || op == OP_XSUB_IMM || op == OP_XGT_IMM ||
+                 op == OP_XRELU)
+            ++i;  // Skip the one-byte immediate of the SIMD instructions (never a jump destination).
