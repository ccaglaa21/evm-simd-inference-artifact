+// ============ SIMD opcode implementations ============
+    static inline Result xtranspose(StackTop stack, int64_t gas_left, ExecutionState& state) noexcept {
+        const auto mem_offset = stack.pop();
+        // SECURITY: MatrixHeader is 32 bytes. Check the memory bound (like standard EVM).
+        // Prevents out-of-bounds access/heap corruption; expands memory when needed (charging gas).
+        if (!check_memory(gas_left, state.memory, mem_offset, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        uint8_t* matrix_ptr = &state.memory[static_cast<size_t>(mem_offset)];
+        evmone::numpy::op_xtranspose(matrix_ptr);
+        return {EVMC_SUCCESS, gas_left};
+    }
+
+    // XGATHER: NumPy fancy indexing. result[i] = data[indices[i]].
+    // Stack: [Data_Offset, Indices_Offset, Res_Offset]
+    // SECURITY: check_memory for all three regions (MatrixHeader 32 bytes + data).
+    // Note: the gather bounds check also exists inside op_xgather (target_idx < max_data_idx).
+    static inline Result xgather(StackTop stack, int64_t gas_left, ExecutionState& state) noexcept {
+        const auto off_data = stack.pop();
+        const auto off_ind = stack.pop();
+        const auto off_res = stack.pop();
+        // SECURITY + CORRECTNESS: read the headers first, compute the real data sizes.
+        // Data: at least header(32) + rows*cols*2 bytes. Res: header(32) + index_count*2 bytes.
+        // First guarantee 32-byte access to read the headers:
+        if (!check_memory(gas_left, state.memory, off_data, 32)) return {EVMC_OUT_OF_GAS, gas_left};
+        if (!check_memory(gas_left, state.memory, off_ind, 32)) return {EVMC_OUT_OF_GAS, gas_left};
+        // Read the index count (rows*cols) from the index header, reserve enough space for Res.
+        // The products and byte sizes are formed in 256-bit arithmetic: a 64-bit product of two header
+        // fields can wrap (rows = 2^32, cols = 2^31 gives 2^63, and 2^63 * 2 wraps to 0), which would pass
+        // a 64-bit size check and let op_xgather read or write outside the memory. The 256-bit size
+        // overload of check_memory rejects any size above 2^32-1, so after these checks the products fit
+        // in size_t without wrap and op_xgather uses the same values.
+        {
+            uint64_t ir, ic;
+            std::memcpy(&ir, &state.memory[static_cast<size_t>(off_ind)], 8);
+            std::memcpy(&ic, &state.memory[static_cast<size_t>(off_ind)] + 8, 8);
+            const uint256 n_idx = uint256(ir) * uint256(ic);
+            // For Data: header + (data size). Read from the Data header.
+            uint64_t dr, dc;
+            std::memcpy(&dr, &state.memory[static_cast<size_t>(off_data)], 8);
+            std::memcpy(&dc, &state.memory[static_cast<size_t>(off_data)] + 8, 8);
+            const uint256 n_data = uint256(dr) * uint256(dc);
+            const uint256 need_data = uint256(32) + n_data * uint256(2);
+            const uint256 need_idx = uint256(32) + n_idx * uint256(2);
+            if (!check_memory(gas_left, state.memory, off_data, need_data)) return {EVMC_OUT_OF_GAS, gas_left};
+            if (!check_memory(gas_left, state.memory, off_ind, need_idx)) return {EVMC_OUT_OF_GAS, gas_left};
+            if (!check_memory(gas_left, state.memory, off_res, need_idx)) return {EVMC_OUT_OF_GAS, gas_left};
+        }
+        uint8_t* pData = &state.memory[static_cast<size_t>(off_data)];
+        uint8_t* pInd = &state.memory[static_cast<size_t>(off_ind)];
+        uint8_t* pRes = &state.memory[static_cast<size_t>(off_res)];
+        evmone::numpy::op_xgather(pData, pInd, pRes);
+        return {EVMC_SUCCESS, gas_left};
+    }
