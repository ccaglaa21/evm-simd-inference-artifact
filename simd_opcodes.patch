+// --- IMMEDIATE CONFIG XMUL ---
+    static inline code_iterator xmul_imm(StackTop stack, ExecutionState& state, code_iterator pos) noexcept
+    {
+        (void)state;
+       const uint8_t lane_width = pos[1] & 0x03;
