+                case 2: { using T = simdpp::int32<8>;  auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+                case 3: { using T = simdpp::int16<16>; auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+            }
+        } else {
+            switch (lane_width) {
+                case 0: { using T = simdpp::uint8<32>;  auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+                case 1: { using T = simdpp::uint16<16>; auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+                case 2: { using T = simdpp::uint32<8>;  auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+                case 3: { using T = simdpp::uint16<16>; auto a = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v1)); auto b = simdpp::load_u<T>(reinterpret_cast<const uint8_t*>(&v2)); simdpp::store_u(reinterpret_cast<uint8_t*>(&v2), simdpp::bit_cast<T>(simdpp::cmp_gt(a, b))); break; }
+            }
+        }
+
+        static_cast<void>(stack.pop());
+        return pos + 2;
+    }
+    
+    // --- IMMEDIATE MAC (multiply-accumulate, 8-lane, 16->32 widening) ---
+    static inline code_iterator xmacc_imm(StackTop stack, ExecutionState& state, code_iterator pos) noexcept
+    {
+        (void)state;
+        auto& va = stack[0];
+        auto& vb = stack[1];
+        auto& vacc = stack[2];
+       auto a = simdpp::load_u<simdpp::int16<8>>(reinterpret_cast<const uint8_t*>(&va));
+        auto b = simdpp::load_u<simdpp::int16<8>>(reinterpret_cast<const uint8_t*>(&vb));
+        auto acc = simdpp::load_u<simdpp::int32<8>>(reinterpret_cast<const uint8_t*>(&vacc));
+
+        auto prod = simdpp::mull(a, b);
+        auto result = simdpp::add(acc, prod);
+        simdpp::store_u(reinterpret_cast<uint8_t*>(&vacc), result);
+        static_cast<void>(stack.pop());
+        static_cast<void>(stack.pop());
+        return pos + 1;
+    }
+
+    // --- XMACC_S: STRIDE-AWARE MACC (uses the zero-copy transpose without copying) ---
+    // Stack: [Mat_Offset, Inp_Offset, Acc_Offset]. config byte (pos[1]) = row index r.
+    // Reads row r of the transposed matrix (an original column, strided) WITHOUT COPYING.
+    // NOTE: libsimdpp has no gather -> 8 elements are read scalar (strided), then SIMD multiply.
+    //      Loading is strided/scalar, computation (mull/add) is SIMD. The zero-copy transpose is preserved.
+    // XMACC_S (v2 + SECURITY): stride-aware MAC, STRIDED SIMD read via AVX2 gather (3/3 SIMD).
+    // Stack (pop order): off_mat, off_inp, off_acc, row, start_col.
+    //   row, start_col: narrowed from uint256. Read: data[row*stride_row+(start_col+j)*stride_col].
+    // Preserves the zero-copy transpose: the matrix is not copied, it is read strided via AVX2 gather.
+    // SECURITY: like standard EVM, check_memory BEFORE every access. The highest byte touched
+    //   by the gather is computed in uint256 (no overflow) and verified. An out-of-bounds or
+    //   int32-exceeding index -> clean EVMC_OUT_OF_GAS; NO READ/WRITE of host memory.
+    static inline Result xmacc_strided(StackTop stack, int64_t gas_left, ExecutionState& state) noexcept
+    {
+        const auto off_mat = stack.pop();
+        const auto off_inp = stack.pop();
+        const auto off_acc = stack.pop();
+        const auto row_u   = stack.pop();
+        const auto start_u = stack.pop();
+
+        // (1) Is the MatrixHeader (32 bytes) accessible? Also bounds off_mat (offset <= 2^32-1).
+        if (!check_memory(gas_left, state.memory, off_mat, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        uint8_t* pMat = &state.memory[static_cast<size_t>(off_mat)];
+        evmone::numpy::MatrixHeader h;
+        std::memcpy(&h, pMat, sizeof(evmone::numpy::MatrixHeader));
+
+        // (2) Input 16 bytes (8x int16) + accumulator 32 bytes (READ + WRITE).
+        if (!check_memory(gas_left, state.memory, off_inp, 16))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        if (!check_memory(gas_left, state.memory, off_acc, 32))
+            return {EVMC_OUT_OF_GAS, gas_left};
+
+        // (3) row/start_col must fit in 64 bits (so the uint64 cast agrees with the uint256 arithmetic).
+        if (((row_u[3] | row_u[2] | row_u[1]) != 0) ||
+            ((start_u[3] | start_u[2] | start_u[1]) != 0))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        // The HIGHEST element index touched by the gather (uint256, no overflow):
+        //   max_elem = row*stride_row + (start_col+7)*stride_col
+        const uint256 max_elem = row_u * uint256(h.stride_row)
+                               + (start_u + uint256(7)) * uint256(h.stride_col);
+        // Highest byte = off_mat + 32(header) + max_elem*2(scale) ; +4 = 32-bit read width.
+        const uint256 gather_top = off_mat + uint256(32) + max_elem * uint256(2);
+        if (!check_memory(gas_left, state.memory, gather_top, 4))
+            return {EVMC_OUT_OF_GAS, gas_left};
+        // If we reach this point, gather_top <= 2^32-1  =>  max_elem <= 2^31-1  =>
+        // all gather indices are in [0, 2^31-1]: positive int32, no overflow.
+
+        const int16_t* data = reinterpret_cast<const int16_t*>(pMat + sizeof(evmone::numpy::MatrixHeader));
+        uint8_t* pInp = &state.memory[static_cast<size_t>(off_inp)];
+        uint8_t* pAcc = &state.memory[static_cast<size_t>(off_acc)];
+        const uint64_t row = static_cast<uint64_t>(row_u);
+        const uint64_t start_col = static_cast<uint64_t>(start_u);
+
+        // --- 3/3 SIMD: the strided read is SIMD too (AVX2 gather). The arithmetic below is IDENTICAL to the original. ---
+        const int32_t base_idx = static_cast<int32_t>(row * h.stride_row + start_col * h.stride_col);
+        const int32_t sc = static_cast<int32_t>(h.stride_col);
+#if defined(__AVX2__)
+        // --- AVX2 path: strided read via SIMD gather (3/3 SIMD) ---
+        __m256i idx = _mm256_setr_epi32(base_idx, base_idx+sc, base_idx+2*sc, base_idx+3*sc,
+                                        base_idx+4*sc, base_idx+5*sc, base_idx+6*sc, base_idx+7*sc);
+        __m256i g = _mm256_i32gather_epi32(reinterpret_cast<const int*>(data), idx, 2);
+        __m256i mat_v = _mm256_srai_epi32(_mm256_slli_epi32(g, 16), 16);
+        __m128i inp16 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(pInp));
+        __m256i inp_v = _mm256_cvtepi16_epi32(inp16);
+        __m256i acc = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(pAcc));
+        __m256i prod = _mm256_mullo_epi32(mat_v, inp_v);
+        __m256i res = _mm256_add_epi32(acc, prod);
+        _mm256_storeu_si256(reinterpret_cast<__m256i*>(pAcc), res);
+#else
+        // --- SCALAR FALLBACK: when AVX2 is unavailable (ARM, older x86). BIT-EXACT identical to the AVX2 path. ---
+        // Determinism: the wrap behaviour must be identical to mullo_epi32 / add_epi32.
+        // All eight matrix, input and accumulator lanes are read before the first write, as the AVX2
+        // path does, so that an accumulator region overlapping the operands gives the same result.
+        const int16_t* pInp16 = reinterpret_cast<const int16_t*>(pInp);
+        int32_t* pAcc32 = reinterpret_cast<int32_t*>(pAcc);
+        int32_t mat_v[8], inp_v[8], acc_v[8];
+        for (int j = 0; j < 8; ++j) {
+            const int32_t element_idx = base_idx + j * sc;                 // idx[j]
+            mat_v[j] = static_cast<int32_t>(data[element_idx]);            // int16->int32 sign-extend
+            inp_v[j] = static_cast<int32_t>(pInp16[j]);                    // int16->int32 sign-extend
+            acc_v[j] = pAcc32[j];
+        }
+        for (int j = 0; j < 8; ++j) {
+            const int32_t prod  = static_cast<int32_t>(                    // mullo_epi32: low 32-bit wrap
+                static_cast<uint32_t>(mat_v[j]) * static_cast<uint32_t>(inp_v[j]));
+            pAcc32[j] = static_cast<int32_t>(                              // add_epi32: 32-bit wrap
+                static_cast<uint32_t>(acc_v[j]) + static_cast<uint32_t>(prod));
+        }
+#endif
+        return {EVMC_SUCCESS, gas_left};
+    }
+
+     // --- IMMEDIATE RELU (max(0,x), 8-lane 32-bit signed) ---
+    static inline code_iterator xrelu_imm(StackTop stack, ExecutionState& state, code_iterator pos) noexcept
+    {
+        (void)state;
+      // The immediate shift is clamped to 31: a shift of 32 or more clears every lane (the lanes are
+        // non-negative after the ReLU), and the clamp makes the vector path and the scalar path agree
+        // for every immediate value (a 32-bit shift by 32 or more is undefined in C++, and the two
+        // backends would otherwise differ).
+        const uint8_t shift = pos[1] > 31 ? 31 : pos[1];
+        auto& v = stack[0];
+        auto x = simdpp::load_u<simdpp::int32<8>>(reinterpret_cast<const uint8_t*>(&v));
+        auto zero = simdpp::make_int<simdpp::int32<8>>(0);
+        auto r = simdpp::max(x, zero);
+        if (shift > 0) r = simdpp::shift_r(r, static_cast<unsigned>(shift));
+        // Saturate to int16 range (fused ReLU + requantize + saturate)
+        r = simdpp::min(r, simdpp::make_int<simdpp::int32<8>>(32767));
+        simdpp::store_u(reinterpret_cast<uint8_t*>(&v), r);
+        return pos + 2;
+
+    }
+    // --- XSUM32: 8-lane int32 lane reduction (horizontal sum) ---
+    static inline void xsum32(StackTop stack) noexcept
+    {
+        const auto v = stack.pop();
+        auto a = simdpp::load_u<simdpp::int32<8>>(reinterpret_cast<const uint8_t*>(&v));
+        int32_t s = simdpp::reduce_add(a);
+        uint256 r = static_cast<uint256>(static_cast<uint32_t>(s));
+        stack.push(r);
+    }
+    // --- XPACK: 8-lane int32 -> 8-lane int16 narrow (saturated pack) ---
+    // Input: 8x int32 (each lane a neuron score, in [0,32767] since it comes from XRELU).
+    // Output: 8x int16 (first 16 bytes), in the XMACC input format of the next layer.
+    static inline void xpack(StackTop stack) noexcept
+    {
+        auto& v = stack[0];
+        // Input: 8x int32 (32 bytes). Narrow each int32 to int16 manually.
+        uint8_t* p = reinterpret_cast<uint8_t*>(&v);
+        int32_t in32[8];
+        std::memcpy(in32, p, 32);                 // read 8 int32 values
+        int16_t out16[16] = {0};                  // 8 int16 (first 16 bytes) + 16 zero bytes
+        for (int i = 0; i < 8; ++i) {
+            int32_t val = in32[i];
+            if (val > 32767) val = 32767;          // saturate high
+            if (val < -32768) val = -32768;        // saturate low
+            out16[i] = static_cast<int16_t>(val);
+        }
+        std::memcpy(p, out16, 32);                 // first 16 bytes int16x8, rest zero
+    }
+// ============ end of SIMD opcodes ============
 inline constexpr auto pop = noop;
 inline constexpr auto jumpdest = noop;
 
